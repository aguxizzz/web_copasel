# ----------------------------------------------------------------------------
# Plantilla de variables de entorno. Copiar a .env y completar con valores reales.
# El .env real NO se commitea.
# ----------------------------------------------------------------------------

# Base de datos (Neon)
DATABASE_URL=postgresql://user:password@host/dbname

# Auth / secretos (valores reales, p. ej. un UUID para SECRET_KEY)
SECRET_KEY=
ALGORITHM=HS256
ADMIN_PASSWORD=
API_KEY=
SECRET_NCON=9997

# CORS (orígenes permitidos del frontend, separados por coma)
ALLOW_ORIGINS=https://tu-frontend.com,http://localhost:3000

# Cloudflare R2 (object storage de boletas) — bucket PRIVADO
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET=copasel
R2_ACCESS_KEY=
R2_SECRET_KEY=
